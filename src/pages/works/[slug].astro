---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkRow from '../../components/WorkRow.astro';
import SoundCloudPlayer from '../../components/SoundCloudPlayer.astro';
import WorkInterest from '../../components/WorkInterest.astro';
import { CATEGORY_META } from '../../content.config';
import { SITE } from '../../config';
import { href } from '../../lib/paths';
import {
  categoryPath,
  getVisibleWorks,
  partLabel,
  relatedWorks,
  seriesMembers,
  seriesPath,
  workPath,
  workSlug,
  type Work,
} from '../../lib/works';

export const getStaticPaths = (async () => {
  const works = await getVisibleWorks();
  return works.map((work) => ({
    params: { slug: workSlug(work) },
    props: {
      work,
      // A work in an album is related to its siblings first; the generic
      // scorer already ranks them highest, so they need no special case here.
      related: relatedWorks(work, works),
      siblings: work.data.series ? seriesMembers(works, work.data.series.id.id) : [],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  work: Work;
  related: Work[];
  siblings: Work[];
}

const { work, related, siblings } = Astro.props as Props;
const { data } = work;
const { Content } = await render(work);

const album = data.series ? await getEntry(data.series.id) : undefined;
const part = partLabel(work);

const category = CATEGORY_META[data.primaryCategory];
const soundcloud = data.media.filter((m) => m.type === 'soundcloud');
const otherMedia = data.media.filter((m) => m.type !== 'soundcloud');

const specs = [
  { label: 'Year', value: String(data.year) },
  { label: 'Category', value: category.label },
  { label: 'Instrumentation', value: data.instrumentation },
  { label: 'Duration', value: data.duration },
].filter((spec): spec is { label: string; value: string } => Boolean(spec.value));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  name: data.title,
  url: new URL(workPath(work), SITE.url).href,
  composer: { '@type': 'Person', name: SITE.name, url: SITE.url },
  dateCreated: String(data.year),
  ...(data.shortDescription ? { description: data.shortDescription } : {}),
  ...(data.duration
    ? { duration: `PT${data.duration.split(':')[0]}M${data.duration.split(':')[1]}S` }
    : {}),
  genre: category.label,
  ...(album
    ? {
        isPartOf: {
          '@type': 'MusicAlbum',
          name: album.data.title,
          url: new URL(seriesPath(album.id), SITE.url).href,
        },
      }
    : {}),
  ...(data.media.length ? { sameAs: data.media.map((m) => m.url) } : {}),
  ...(data.performances.length
    ? {
        subjectOf: data.performances.map((p) => ({
          '@type': 'Event',
          name: p.event ?? `${data.title} — performance`,
          ...(p.date ? { startDate: p.date } : {}),
          ...(p.venue
            ? {
                location: {
                  '@type': 'Place',
                  name: p.venue,
                  ...(p.city ? { address: [p.city, p.country].filter(Boolean).join(', ') } : {}),
                },
              }
            : {}),
        })),
      }
    : {}),
};

---
<BaseLayout
  title={data.title}
  description={data.shortDescription ?? `${data.title} (${data.year}) by ${SITE.name}.`}
  jsonLd={jsonLd}
>
  <article>
    <header class="shell sec">
      <nav class="sec__label crumbs" aria-label="Breadcrumb">
        <a class="link" href={href('/works')}>Works</a>
        <span aria-hidden="true">/</span>
        <a class="link" href={categoryPath(data.primaryCategory)}>{category.short}</a>
        {
          album && (
            <>
              <span aria-hidden="true">/</span>
              <a class="link" href={seriesPath(album.id)}>
                {album.data.title}
                {part && ` ${part}`}
              </a>
            </>
          )
        }
      </nav>
      <div class="sec__body">
        <h1 class="title-l work-title">{data.title}</h1>
        {data.shortDescription && <p class="work-lead">{data.shortDescription}</p>}
      </div>
    </header>

    <section class="shell sec" aria-label="Details">
      <p class="sec__label">Details</p>
      <dl class="sec__body specs">
        {
          specs.map((spec) => (
            <div class="specs__row">
              <dt class="specs__label">{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      soundcloud.length > 0 && (
        <section class="shell sec" aria-label="Recordings">
          <p class="sec__label">Recordings</p>
          <div class="sec__body players">
            {soundcloud.map((item) => (
              <SoundCloudPlayer url={item.url} title={item.title} note={item.note} workTitle={data.title} />
            ))}
          </div>
        </section>
      )
    }

    <section class="shell sec">
      <p class="sec__label">About the work</p>
      <div class="sec__body body">
        <div class="body__main prose">
          <Content />
        </div>

        <aside class="body__aside">
          <WorkInterest title={data.title} />
          {
            album && (
              <section class="panel">
                <h2>Album</h2>
                <a class="link link--strong" href={seriesPath(album.id)}>
                  {album.data.title}
                </a>
                <p class="album__position muted">
                  {album.data.year} · {siblings.length} {siblings.length === 1 ? 'work' : 'works'}
                </p>
                <ol class="album__list">
                  {siblings.map((sibling) => {
                    const siblingPart = partLabel(sibling);
                    const isCurrent = sibling.id === work.id;
                    return (
                      <li class:list={['album__item', isCurrent && 'is-current']}>
                        <span class="album__numeral index">{siblingPart ?? '—'}</span>
                        {isCurrent ? (
                          <span aria-current="true">{sibling.data.title}</span>
                        ) : (
                          <a class="link" href={workPath(sibling)}>
                            {sibling.data.title}
                          </a>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </section>
            )
          }

          {
            data.technology.length > 0 && (
              <section class="panel">
                <h2>Technology</h2>
                <ul class="panel__list">
                  {data.technology.map((item) => (
                    <li class="panel__item">{item}</li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            data.credits.length > 0 && (
              <section class="panel">
                <h2>Credits</h2>
                <dl class="panel__list">
                  {data.credits.map((credit) => (
                    <div class="panel__pair">
                      <dt class="panel__role">{credit.role}</dt>
                      <dd class="panel__item">{credit.name}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )
          }

          {
            data.performances.length > 0 && (
              <section class="panel">
                <h2>Performances</h2>
                <ul class="panel__list">
                  {data.performances.map((performance) => (
                    <li class="panel__item">
                      {performance.event && <span class="panel__strong">{performance.event}</span>}
                      {performance.performers && <span>{performance.performers}</span>}
                      <span class="panel__role">
                        {[
                          performance.venue,
                          [performance.city, performance.country].filter(Boolean).join(', '),
                          performance.date,
                        ]
                          .filter(Boolean)
                          .join(' · ')}
                      </span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            data.secondaryTags.length > 0 && (
              <section class="panel">
                <h2>Tags</h2>
                <ul class="tags">
                  {data.secondaryTags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            (data.links.length > 0 || otherMedia.length > 0) && (
              <section class="panel">
                <h2>Links</h2>
                <ul class="panel__list">
                  {otherMedia.map((item) => (
                    <li>
                      <a class="link" href={item.url} rel="noopener noreferrer" target="_blank">
                        {item.title ?? item.type} →
                      </a>
                    </li>
                  ))}
                  {data.links.map((item) => (
                    <li>
                      <a class="link" href={item.url} rel="noopener noreferrer" target="_blank">
                        {item.label} →
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </aside>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="shell sec" aria-labelledby="related-heading">
          <h2 id="related-heading" class="sec__label">
            Related works
          </h2>
          <div class="sec__body entries">
            {related.map((item, i) => (
              <WorkRow work={item} index={i} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .crumbs {
    font-weight: 400;
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0 0.4rem;
  }

  .work-title {
    max-width: 22ch;
  }

  .work-lead {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--grey);
    font-size: var(--fs-read);
  }

  .specs {
    display: grid;
    gap: 0.45rem;
    max-width: 62ch;
  }

  .specs__row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .specs__label {
    color: var(--grey);
  }

  .players {
    display: grid;
    gap: 1rem;
    max-width: 62ch;
  }

  .album__position {
    margin-bottom: 0.6rem;
  }

  .album__list {
    display: grid;
    gap: 0.2rem;
  }

  .album__item {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    gap: 0.3rem;
  }

  .album__numeral {
    color: var(--grey);
  }

  .album__item.is-current {
    font-weight: 500;
  }
</style>
