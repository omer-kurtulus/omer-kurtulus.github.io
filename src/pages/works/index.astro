---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkRow from '../../components/WorkRow.astro';
import PageHeader from '../../components/PageHeader.astro';
import { CATEGORY_META } from '../../content.config';
import { getCollection } from 'astro:content';
import {
  categoryCounts,
  categoryPath,
  getVisibleWorks,
  groupByYear,
  seriesMembers,
  seriesPath,
} from '../../lib/works';

const works = await getVisibleWorks();
const years = groupByYear(works);
const counts = categoryCounts(works);

const albums = (await getCollection('series', ({ data }) => data.status !== 'draft'))
  .map((album) => ({ album, members: seriesMembers(works, album.id) }))
  .filter(({ members }) => members.length > 0)
  .sort((a, b) => b.album.data.year - a.album.data.year);

let running = 0;
---

<BaseLayout
  title="Works"
  description="The complete catalogue of works by Ömer Kurtuluş, newest first."
>
  <PageHeader
    title="Works"
    lead={`${works.length} works, newest first.`}
    index={String(works.length).padStart(2, '0')}
  />

  <section class="shell sec" aria-label="Filter by category">
    <p class="sec__label">Fields</p>
    <ul class="sec__body filters">
      {
        counts.map(({ category, count }) => (
          <li>
            <a class="link" href={categoryPath(category)}>
              {CATEGORY_META[category].short}
            </a>
            <span class="filters__count index"> {String(count).padStart(2, '0')}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    albums.length > 0 && (
      <section class="shell sec" aria-labelledby="albums-heading">
        <h2 id="albums-heading" class="sec__label">
          Albums and projects
        </h2>
        <ul class="sec__body entries">
          {albums.map(({ album, members }) => (
            <li>
              <a class="album" href={seriesPath(album.id)}>
                <span class="album__name title-m">{album.data.title}</span>
                <span class="album__line">
                  <span class="index">
                    {String(members.length).padStart(2, '0')} works
                    {album.data.ongoing && ' so far'}
                  </span>
                  <span class="index">
                    {album.data.ongoing ? `${album.data.year} — ongoing` : album.data.year}
                  </span>
                </span>
                {album.data.summary && <span class="album__summary">{album.data.summary}</span>}
                <span class="album__members small">{members.map((m) => m.data.title).join(' · ')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    years.map(({ year, works: entries }) => {
      const start = running;
      running += entries.length;
      return (
        <section class="shell sec" aria-labelledby={`year-${year}`}>
          <div class="sec__label">
            <h2 id={`year-${year}`} class="year__label">
              {year}
            </h2>
            <span class="index">{String(entries.length).padStart(2, '0')}</span>
          </div>
          <div class="sec__body entries">
            {entries.map((work, i) => (
              <WorkRow work={work} index={start + i} />
            ))}
          </div>
        </section>
      );
    })
  }
</BaseLayout>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.75rem;
  }

  .filters__count {
    color: var(--grey);
  }

  .album {
    display: grid;
    gap: 0.2rem;
    max-width: 62ch;
  }

  .album__name {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 140ms ease;
  }

  .album:hover .album__name {
    text-decoration-color: currentColor;
  }

  .album__line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.45rem;
    color: var(--grey);
  }

  .album__line > * + *::before {
    content: '·';
    margin-right: 0.45rem;
  }

  .album__summary {
    margin-top: 0.35rem;
  }

  .album__members {
    color: var(--grey);
  }

  .year__label {
    color: var(--ink);
    font-weight: 600;
  }
</style>
