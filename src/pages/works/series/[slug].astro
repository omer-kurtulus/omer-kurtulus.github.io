---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkRow from '../../../components/WorkRow.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { SITE } from '../../../config';
import { getVisibleWorks, seriesMembers, workPath, type Work } from '../../../lib/works';
import { href } from '../../../lib/paths';

export const getStaticPaths = (async () => {
  const albums = await getCollection('series', ({ data }) => data.status !== 'draft');
  const works = await getVisibleWorks();

  return albums.map((album) => ({
    params: { slug: album.id },
    props: { album, works: seriesMembers(works, album.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  album: CollectionEntry<'series'>;
  works: Work[];
}

const { album, works } = Astro.props;
const { Content } = await render(album);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: album.data.title,
  byArtist: { '@type': 'Person', name: SITE.name, url: SITE.url },
  numTracks: works.length,
  ...(album.data.summary ? { description: album.data.summary } : {}),
  track: works.map((work) => ({
    '@type': 'MusicComposition',
    name: work.data.title,
    url: new URL(workPath(work), SITE.url).href,
  })),
};
---

<BaseLayout
  title={album.data.title}
  description={album.data.summary ?? `${album.data.title}, an album by ${SITE.name}.`}
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow={album.data.ongoing ? 'Ongoing project' : 'Album'}
    title={album.data.title}
    lead={album.data.summary}
    index={`${String(works.length).padStart(2, '0')} · ${
      album.data.ongoing ? `since ${album.data.year}` : album.data.year
    }`}
  />

  <section class="shell sec">
    <p class="sec__label">About</p>
    <div class="sec__body prose">
      <Content />
    </div>
  </section>

  <section class="shell sec" aria-labelledby="album-works">
    <div class="sec__label">
      <h2 id="album-works">Works in this album</h2>
      <span class="index">{String(works.length).padStart(2, '0')}</span>
    </div>
    <div class="sec__body">
      <div class="entries">
        {works.map((work, i) => <WorkRow work={work} index={i} hideSeries />)}
      </div>
      <p class="back">
        <a class="link" href={href('/works')}>All works →</a>
      </p>
    </div>
  </section>
</BaseLayout>
