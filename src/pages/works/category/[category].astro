---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkRow from '../../../components/WorkRow.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { CATEGORIES, CATEGORY_META, type Category } from '../../../content.config';
import { byCategory, categoryPath, getVisibleWorks, type Work } from '../../../lib/works';
import { href } from '../../../lib/paths';

export const getStaticPaths = (async () => {
  const works = await getVisibleWorks();
  return CATEGORIES.map((category) => ({
    params: { category },
    props: { category, works: byCategory(works, category) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  category: Category;
  works: Work[];
}

const { category, works } = Astro.props;
const meta = CATEGORY_META[category];
const others = CATEGORIES.filter((c) => c !== category);
---
<BaseLayout title={meta.label} description={meta.blurb}>
  <PageHeader
    eyebrow="Works"
    title={meta.label}
    lead={meta.blurb}
    index={String(works.length).padStart(2, '0')}
  />

  <section class="shell sec">
    <p class="sec__label">{meta.short}</p>
    <div class="sec__body">
      {
        works.length > 0 ? (
          <div class="entries">
            {works.map((work, i) => (
              <WorkRow work={work} index={i} />
            ))}
          </div>
        ) : (
          <p class="empty">No works are published in this category yet.</p>
        )
      }
    </div>
  </section>

  <nav class="shell sec" aria-label="Other categories">
    <p class="sec__label">Elsewhere</p>
    <ul class="sec__body jump">
      {
        others.map((other) => (
          <li>
            <a class="link" href={categoryPath(other)}>
              {CATEGORY_META[other].short} →
            </a>
          </li>
        ))
      }
      <li>
        <a class="link link--strong" href={href('/works')}>All works →</a>
      </li>
    </ul>
  </nav>
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.75rem;
  }
</style>
