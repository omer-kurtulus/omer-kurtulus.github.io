---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../config';
import { href } from '../lib/paths';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description ?? SITE.description}>
  <PageHeader title={entry.data.title} lead={SITE.tagline} />

  <section class="shell sec">
    <span class="sec__label"></span>
    <div class="sec__body">
      <div class="prose">
        <Content />
      </div>
      <p class="back">
        <a class="link link--strong" href={href('/contact')}>Commissions, scores and collaborations → Contact</a>
      </p>
    </div>
  </section>
</BaseLayout>
