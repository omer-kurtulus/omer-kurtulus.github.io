---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../config';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description ?? SITE.description}>
  <PageHeader title={entry.data.title} lead={SITE.tagline} />

  <div class="shell">
    <div class="body grid">
      <div class="body__main prose">
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    row-gap: var(--space-m);
    padding-block: var(--space-l);
  }

  .body__main {
    grid-column: 1 / -1;
  }

  /* The red bar that used to sit opposite this text is gone with the
     accent; the column it sat in is given back to the text. */
  @media (min-width: 56rem) {
    .body__main {
      grid-column: 2 / 10;
    }
  }
</style>
