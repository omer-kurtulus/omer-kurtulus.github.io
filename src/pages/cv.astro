---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getVisibleWorks } from '../lib/works';

const entry = await getEntry('pages', 'cv');
if (!entry) throw new Error('Missing src/content/pages/cv.md');
const { Content } = await render(entry);

const works = await getVisibleWorks();
const first = works.at(-1)?.data.year;
const last = works[0]?.data.year;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageHeader
    title="Curriculum Vitae"
    lead={first && last ? `Catalogue spans ${first}–${last}.` : undefined}
    index={String(works.length).padStart(2, '0')}
  />

  <div class="shell">
    <div class="body grid">
      <div class="body__main prose">
        <Content />
      </div>
    </div>

    <p class="body__more">
      <a class="link link--strong" href="/works">Complete catalogue →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: var(--space-l);
  }

  @media (min-width: 56rem) {
    .body__main {
      grid-column: 2 / 10;
    }
  }

  .body__main {
    grid-column: 1 / -1;
  }

  .body__more {
    padding-bottom: var(--space-xl);
  }


</style>
