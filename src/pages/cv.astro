---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getVisibleWorks } from '../lib/works';
import { href } from '../lib/paths';

const entry = await getEntry('pages', 'cv');
if (!entry) throw new Error('Missing src/content/pages/cv.md');
const { Content } = await render(entry);

const works = await getVisibleWorks();
const first = works.at(-1)?.data.year;
const last = works[0]?.data.year;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageHeader
    title="Curriculum Vitae"
    lead={first && last ? `Catalogue spans ${first}–${last}.` : undefined}
    index={String(works.length).padStart(2, '0')}
  />

  <section class="shell sec">
    <span class="sec__label"></span>
    <div class="sec__body">
      <div class="prose cv">
        <Content />
      </div>
      <p class="back">
        <a class="link" href={href('/works')}>Complete catalogue →</a>
        <a class="link" href={href('/contact')}>Commissions, scores and collaborations → Contact</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .cv {
    font-size: var(--fs);
    line-height: 1.65;
  }

  .cv :global(h2) {
    margin-top: 3em;
    color: var(--grey);
    font-size: var(--fs);
    font-weight: 400;
  }

  .cv :global(h2:first-child) {
    margin-top: 0;
  }

  .cv :global(p) {
    margin-top: 0.8em;
  }

  .cv :global(strong) {
    font-weight: 500;
  }
</style>
