---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { href } from '../../lib/paths';

const notes = (await getCollection('research', ({ data }) => data.status !== 'draft')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const dateFormat = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long' });
---

<BaseLayout
  title="Writing"
  description="Articles on sonic archaeology, re-authentication, timbre and the phenomenology of listening, and technical notes on the systems behind individual works."
>
  <PageHeader
    title="Writing"
    lead="Articles and technical notes: sonic archaeology and re-authentication, timbre and its cognition, the phenomenology of silence, and the systems behind individual works."
    index={String(notes.length).padStart(2, '0')}
  />

  <section class="shell sec">
    <p class="sec__label usage-note">
      Shared for reference — please ask the composer before sharing or reproducing
      any of these texts.
    </p>
    <div class="sec__body">
      {
        notes.length > 0 ? (
          <div class="entries">
            {notes.map((note) => (
              <article>
                <a class="text" href={href(`/research/${note.id}`)}>
                  <span class="text__title title-m">{note.data.title}</span>
                  <span class="text__date muted">{dateFormat.format(note.data.date)}</span>
                  {note.data.summary && <span class="text__summary">{note.data.summary}</span>}
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">Notes are in preparation.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .text {
    display: grid;
    gap: 0.2rem;
    max-width: 62ch;
  }

  .text__title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 140ms ease;
  }

  .text:hover .text__title {
    text-decoration-color: currentColor;
  }

  .text__summary {
    margin-top: 0.35rem;
  }
</style>
