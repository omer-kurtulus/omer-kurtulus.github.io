---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../config';
import { href } from '../../lib/paths';

export const getStaticPaths = (async () => {
  const notes = await getCollection('research', ({ data }) => data.status !== 'draft');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}) satisfies GetStaticPaths;

interface Props {
  note: CollectionEntry<'research'>;
}

const { note } = Astro.props;
const { Content } = await render(note);

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: note.data.title,
  datePublished: note.data.date.toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  ...(note.data.summary ? { description: note.data.summary } : {}),
};

const hasAside = note.data.tags.length > 0 || note.data.links.length > 0;
---
<BaseLayout title={note.data.title} description={note.data.summary} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="Writing"
    title={note.data.title}
    lead={note.data.summary}
    index={dateFormat.format(note.data.date)}
  />

  <section class="shell sec">
    <p class="sec__label usage-note">
      Shared for reference — please ask the composer before sharing or reproducing
      this text.
    </p>
    <div class:list={['sec__body', 'body', !hasAside && 'body--single']}>
      <div class="body__main prose">
        <Content />
      </div>

      {
        hasAside && (
          <aside class="body__aside">
            {note.data.tags.length > 0 && (
              <section class="panel">
                <h2>Tags</h2>
                <ul class="tags">
                  {note.data.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </section>
            )}

            {note.data.links.length > 0 && (
              <section class="panel">
                <h2>Links</h2>
                <ul class="panel__list">
                  {note.data.links.map((link) => (
                    <li>
                      <a class="link" href={link.url} rel="noopener noreferrer" target="_blank">
                        {link.label} →
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </aside>
        )
      }
    </div>
  </section>

  <div class="shell sec">
    <span class="sec__label"></span>
    <p class="sec__body">
      <a class="link" href={href('/research')}>← All writing</a>
    </p>
  </div>
</BaseLayout>
