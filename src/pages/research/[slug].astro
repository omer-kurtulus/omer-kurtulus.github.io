---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../config';

export const getStaticPaths = (async () => {
  const notes = await getCollection('research', ({ data }) => data.status !== 'draft');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}) satisfies GetStaticPaths;

interface Props {
  note: CollectionEntry<'research'>;
}

const { note } = Astro.props;
const { Content } = await render(note);

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: note.data.title,
  datePublished: note.data.date.toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  ...(note.data.summary ? { description: note.data.summary } : {}),
};
---

<BaseLayout title={note.data.title} description={note.data.summary} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="Research"
    title={note.data.title}
    lead={note.data.summary}
    index={dateFormat.format(note.data.date)}
  />

  <div class="shell">
    <div class="body grid">
      <div class="body__main prose">
        <Content />
      </div>

      <aside class="body__aside">
        {
          note.data.tags.length > 0 && (
            <section class="panel">
              <h2 class="eyebrow">Tags</h2>
              <ul class="tags">
                {note.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          note.data.links.length > 0 && (
            <section class="panel">
              <h2 class="eyebrow">Links</h2>
              <ul class="panel__list">
                {note.data.links.map((link) => (
                  <li>
                    <a class="link" href={link.url} rel="noopener noreferrer" target="_blank">
                      {link.label} →
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>

    <p class="back">
      <a class="link link--strong" href="/research">← All notes</a>
    </p>
  </div>
</BaseLayout>

<style>
  .body {
    row-gap: var(--space-l);
    padding-block: var(--space-l);
  }

  .body__main {
    grid-column: 1 / -1;
  }

  .body__aside {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  @media (min-width: 56rem) {
    .body__main {
      grid-column: 1 / 8;
    }
    .body__aside {
      grid-column: 9 / -1;
    }
  }

  .panel {
    border-top: var(--rule-thin) solid var(--color-line);
    padding-top: var(--space-xs);
  }

  .panel__list {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-xs);
  }

  .tag {
    padding: 0.1em 0.5em;
    border: var(--rule-hair) solid var(--color-line);
    font-size: var(--step--2);
    font-stretch: 78%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .back {
    padding-bottom: var(--space-xl);
  }
</style>
