---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { PROFILES, SITE } from '../config';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing src/content/pages/contact.md');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageHeader title="Contact" />

  <div class="shell">
    <div class="body grid">
      <div class="body__main prose">
        <Content />
      </div>

      <div class="body__aside">
        {
          SITE.email && (
            <section class="panel">
              <h2 class="eyebrow">Email</h2>
              <p class="panel__value">
                <a class="link link--strong" href={`mailto:${SITE.email}`}>
                  {SITE.email}
                </a>
              </p>
            </section>
          )
        }

        <section class="panel">
          <h2 class="eyebrow">Listen</h2>
          <ul class="panel__list">
            {
              PROFILES.map((profile) => (
                <li>
                  <a class="link" href={profile.url} rel="me noopener noreferrer" target="_blank">
                    {profile.label} →
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    row-gap: var(--space-l);
    padding-block: var(--space-l) var(--space-2xl);
  }

  .body__main {
    grid-column: 1 / -1;
  }

  .body__aside {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  @media (min-width: 56rem) {
    .body__main {
      grid-column: 1 / 7;
    }
    .body__aside {
      grid-column: 9 / -1;
    }
  }

  .panel {
    border-top: var(--rule-thin) solid var(--color-line);
    padding-top: var(--space-xs);
  }

  .panel__value {
    margin-top: var(--space-xs);
  }

  .panel__list {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }
</style>
