---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactOptions from '../components/ContactOptions.astro';
import { AGORA, FOLLOW, PROFILES, SITE } from '../config';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing src/content/pages/contact.md');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageHeader title="Contact" />

  {
    SITE.email && (
      <section class="shell sec">
        <h2 class="sec__label">Email</h2>
        <div class="sec__body">
          <ContactOptions to={SITE.email} />
        </div>
      </section>
    )
  }

  <section class="shell sec">
    <span class="sec__label"></span>
    <div class="sec__body body">
      <div class="body__main prose">
        <Content />
      </div>

      <div class="body__aside">
        <section class="panel">
          <h2>Listen</h2>
          <ul class="panel__list">
            {
              PROFILES.map((profile) => (
                <li>
                  <a class="link" href={profile.url} rel="me noopener noreferrer" target="_blank">
                    {profile.label} →
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="panel">
          <h2>Stay in touch</h2>
          <p class="panel__value">
            <a class="link" href={FOLLOW.url} rel="noopener noreferrer" target="_blank">
              {FOLLOW.label} →
            </a>
          </p>
          <p class="panel__note">New releases, the moment they are out.</p>
        </section>

        <section class="panel">
          <h2>{AGORA.role}, {AGORA.name}</h2>
          <p class="panel__note">{AGORA.blurb}</p>
          <ul class="panel__list">
            <li>
              <a class="link" href={AGORA.url} rel="noopener noreferrer" target="_blank">
                Visit the Agora →
              </a>
            </li>
            <li>
              <a class="link" href={`mailto:${AGORA.email}`}>{AGORA.email}</a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
