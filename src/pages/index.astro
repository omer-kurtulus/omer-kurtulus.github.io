---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import { CATEGORY_META } from '../content.config';
import { CURRENT, SITE } from '../config';
import {
  byCategory,
  categoryCounts,
  categoryPath,
  getPublishedWorks,
  getVisibleWorks,
  selectFeatured,
} from '../lib/works';

const published = await getPublishedWorks();
const visible = await getVisibleWorks();

// The three newest works, recording or not. `date` is the sort key that
// decides this, so keep it truthful and never post-date a work to push it up
// the page — a future date would silently take the top of the home page.
const recent = published.slice(0, 3);
const recentIds = new Set(recent.map((w) => w.id));

// Featured works that the Recent block has not already shown.
const featured = selectFeatured(published, 8).filter((w) => !recentIds.has(w.id));

const counts = categoryCounts(published);
const foreground = counts.filter(({ category }) => category !== 'acoustic');

// Acoustic sits apart as a quieter archive layer. Anything already shown above
// is left out, so no work appears twice on the same page.
const shownAbove = new Set([...recentIds, ...featured.map((w) => w.id)]);
const acoustic = byCategory(visible, 'acoustic').filter((w) => !shownAbove.has(w.id));
---

<BaseLayout isHome jsonLd={undefined}>
  <section class="hero">
    <div class="shell">
      <div class="hero__grid grid">
        <h1 class="hero__name display">
          Ömer<br />Kurtuluş
        </h1>

        <div class="hero__aside">
          <p class="hero__role eyebrow">{SITE.role}</p>
          <p class="hero__tagline">{SITE.tagline}</p>
        </div>

        <!-- Structural marks: they sit on the grid, they do not decorate it. -->
        <div class="hero__marks" aria-hidden="true">
          <span class="hero__bar"></span>
          <span class="hero__dot"></span>
        </div>
      </div>
    </div>
  </section>

  {
    CURRENT && (
      <section class="section shell current" aria-labelledby="current-heading">
        <div class="head">
          <h2 id="current-heading" class="eyebrow">
            {CURRENT.eyebrow}
          </h2>
          <p class="head__count index">{CURRENT.until}</p>
        </div>
        <a class="current__link" href={CURRENT.href}>
          <span class="current__title title-m">{CURRENT.title}</span>
          <span class="current__blurb">{CURRENT.blurb}</span>
          <span class="current__cta">{CURRENT.cta} →</span>
        </a>
      </section>
    )
  }

  <section class="section shell" aria-labelledby="recent-heading">
    <div class="head">
      <h2 id="recent-heading" class="eyebrow">Recent</h2>
      <p class="head__count index">{published[0]?.data.year}</p>
    </div>
    <div class="list">
      {recent.map((work, i) => <WorkRow work={work} index={i} variant="large" />)}
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section shell" aria-labelledby="featured-heading">
        <div class="head">
          <h2 id="featured-heading" class="eyebrow">
            Featured Works
          </h2>
          <a class="link" href="/works">
            All works →
          </a>
        </div>
        <div class="list">
          {featured.map((work, i) => (
            <WorkRow work={work} index={recent.length + i} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section shell" aria-labelledby="fields-heading">
    <h2 id="fields-heading" class="eyebrow">Fields of work</h2>
    <ul class="fields">
      {
        foreground.map(({ category, count }) => (
          <li class:list={['field', `field--${category}`]}>
            <a class="field__link" href={categoryPath(category)}>
              <span class="field__head">
                <span class:list={['mark', `mark--${category}`]} aria-hidden="true" />
                <span class="field__count index">
                  {String(count).padStart(2, '0')} {count === 1 ? 'work' : 'works'}
                </span>
              </span>
              <span class="field__label title-m">{CATEGORY_META[category].label}</span>
              <span class="field__blurb">{CATEGORY_META[category].blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section shell" aria-labelledby="acoustic-heading">
    <div class="head head--quiet">
      <h2 id="acoustic-heading" class="eyebrow">Acoustic — archive</h2>
      <a class="link" href={categoryPath('acoustic')}>Open archive →</a>
    </div>
    <p class="head__note meta meta--tight">{CATEGORY_META.acoustic.blurb}</p>
    <div class="list list--quiet">
      {acoustic.map((work, i) => <WorkRow work={work} index={i} variant="compact" />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-l);
    padding-bottom: var(--space-s);
  }

  .hero__grid {
    row-gap: var(--space-m);
    align-items: end;
  }

  .hero__name {
    grid-column: 1 / -1;
    margin: 0;
  }

  .hero__aside {
    grid-column: 1 / -1;
    max-width: 42ch;
  }

  .hero__role {
    margin-bottom: var(--space-xs);
  }

  .hero__tagline {
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .hero__marks {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .hero__bar {
    flex: 1 1 auto;
    height: var(--rule-thick);
    background: var(--color-text);
  }

  .hero__dot {
    flex: none;
    width: var(--space-s);
    height: var(--space-s);
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Asymmetry comes from column skips, not from offsets. */
  @media (min-width: 56rem) {
    .hero {
      padding-top: var(--space-xl);
    }

    .hero__name {
      grid-column: 1 / 9;
    }

    .hero__aside {
      grid-column: 9 / -1;
      padding-bottom: 0.4em;
    }

    .hero__marks {
      grid-column: 1 / 9;
    }
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    padding-bottom: var(--space-s);
  }

  .head--quiet {
    border-bottom: var(--rule-hair) solid var(--color-line);
  }

  .head__note {
    max-width: 52ch;
    margin-top: var(--space-s);
  }

  .list {
    margin-top: var(--space-2xs);
    border-bottom: var(--rule-thin) solid var(--color-line);
  }

  .list--quiet {
    margin-top: var(--space-m);
    border-bottom-width: var(--rule-hair);
  }

  .fields {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  @media (min-width: 48rem) {
    .fields {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--grid-gap);
    }
  }

  .field {
    border-top: var(--rule-thin) solid var(--color-line);
  }

  .field--ai {
    border-top-width: var(--rule-thick);
    border-top-color: var(--color-text);
  }
  .field--electroacoustic {
    border-top-width: var(--rule-medium);
  }
  .field--electronic {
    border-top-width: var(--rule-thin);
  }

  .field__link {
    display: block;
    height: 100%;
    padding-top: var(--space-s);
    padding-bottom: var(--space-s);
    transition: background-color 120ms linear;
  }

  .field__link:hover {
    background-color: var(--color-surface);
  }

  .field__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-s);
  }

  .field__count {
    text-transform: uppercase;
  }

  .field__label {
    display: block;
    text-wrap: balance;
  }

  .field__blurb {
    display: block;
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* The open call is louder than a work row on purpose: it has a deadline and
     it is the one thing on this page a visitor can act on today. It is still
     not a nav entry — when the call closes, CURRENT goes to null and the block
     leaves without a trace. */
  .current__link {
    display: block;
    border: var(--rule-medium) solid var(--color-line);
    padding: var(--space-m);
    transition: border-color 120ms linear, background-color 120ms linear;
  }

  .current__link:hover {
    border-color: var(--color-accent);
    background-color: var(--color-surface);
  }

  .current__title {
    display: block;
    margin-bottom: var(--space-xs);
  }

  .current__blurb {
    display: block;
    max-width: 62ch;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .current__cta {
    display: inline-block;
    margin-top: var(--space-s);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* The date line is prose, not a catalogue figure, so it should not be
     tracked out like one. */
  .current .head__count {
    letter-spacing: 0.04em;
    text-transform: none;
  }
</style>
