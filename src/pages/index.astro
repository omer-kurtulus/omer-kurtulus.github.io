---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import { CATEGORY_META } from '../content.config';
import { CURRENT } from '../config';
import {
  byCategory,
  categoryCounts,
  categoryPath,
  getPublishedWorks,
  getVisibleWorks,
  selectFeatured,
} from '../lib/works';

const published = await getPublishedWorks();
const visible = await getVisibleWorks();

// The three newest works, recording or not. `date` is the sort key that
// decides this, so keep it truthful and never post-date a work to push it up
// the page — a future date would silently take the top of the home page.
const recent = published.slice(0, 3);
const recentIds = new Set(recent.map((w) => w.id));

// Featured works that the Recent block has not already shown.
const featured = selectFeatured(published, 8).filter((w) => !recentIds.has(w.id));

const counts = categoryCounts(published);
const foreground = counts.filter(({ category }) => category !== 'acoustic');

// Acoustic sits apart as a quieter archive layer. Anything already shown above
// is left out, so no work appears twice on the same page.
const shownAbove = new Set([...recentIds, ...featured.map((w) => w.id)]);
const acoustic = byCategory(visible, 'acoustic').filter((w) => !shownAbove.has(w.id));
---

{/* The name and the tagline are in the masthead on every page now, this one
    included, so the home page opens on the work rather than on a wordmark. */}
<BaseLayout isHome jsonLd={undefined}>
  {
    CURRENT && (
      <section class="section--tight shell current" aria-labelledby="current-heading">
        <a class="note current__link" href={CURRENT.href}>
          <span class="eyebrow">{CURRENT.eyebrow}</span>
          <span id="current-heading" class="current__title title-m">
            {CURRENT.title}
          </span>
          <span class="current__blurb">{CURRENT.blurb}</span>
          <span class="current__until">{CURRENT.until}</span>
          <span class="current__cta">{CURRENT.cta} →</span>
        </a>
      </section>
    )
  }

  <section class="section--tight shell" aria-labelledby="recent-heading">
    <div class="head">
      <h2 id="recent-heading" class="eyebrow">Recent</h2>
      <p class="head__count index">{published[0]?.data.year}</p>
    </div>
    <div class="list">
      {recent.map((work, i) => <WorkRow work={work} index={i} variant="large" />)}
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section--tight shell" aria-labelledby="featured-heading">
        <div class="head">
          <h2 id="featured-heading" class="eyebrow">
            Featured works
          </h2>
          <a class="link" href="/works">
            All works →
          </a>
        </div>
        <div class="list">
          {featured.map((work, i) => (
            <WorkRow work={work} index={recent.length + i} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section--tight shell" aria-labelledby="fields-heading">
    <div class="head">
      <h2 id="fields-heading" class="eyebrow">Fields of work</h2>
    </div>
    <ul class="fields">
      {
        foreground.map(({ category, count }) => (
          <li class:list={['field', `field--${category}`]}>
            <a class="field__link" href={categoryPath(category)}>
              <span class="field__head">
                <span class:list={['mark', `mark--${category}`]} aria-hidden="true" />
                <span class="field__count index">
                  {String(count).padStart(2, '0')} {count === 1 ? 'work' : 'works'}
                </span>
              </span>
              <span class="field__label title-m">{CATEGORY_META[category].label}</span>
              <span class="field__blurb">{CATEGORY_META[category].blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section--tight shell" aria-labelledby="acoustic-heading">
    <div class="head">
      <h2 id="acoustic-heading" class="eyebrow">Acoustic — archive</h2>
      <a class="link" href={categoryPath('acoustic')}>Open archive →</a>
    </div>
    <p class="head__note meta meta--tight">{CATEGORY_META.acoustic.blurb}</p>
    <div class="list list--quiet">
      {acoustic.map((work, i) => <WorkRow work={work} index={i} variant="compact" />)}
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
    padding-bottom: var(--space-xs);
  }

  .head__note {
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-s);
  }

  .list {
    border-bottom: var(--rule-thin) solid var(--color-line);
  }

  .fields {
    margin-top: var(--space-2xs);
    border-bottom: var(--rule-thin) solid var(--color-line);
  }

  /* Three fields, three rules, one under the other. At this measure they are
     a list, not a set of cards. */
  .field {
    border-top: var(--rule-thin) solid var(--color-line);
  }

  .field--ai {
    border-top-width: var(--rule-thick);
    border-top-color: var(--color-text);
  }
  .field--electroacoustic {
    border-top-color: var(--color-text);
  }

  .field__link {
    display: block;
    padding-block: var(--space-s);
    transition: background-color 100ms linear;
  }

  .field__link:hover {
    background-color: var(--color-surface);
  }

  .field__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-2xs);
  }

  .field__count {
    text-transform: uppercase;
  }

  .field__label {
    display: block;
  }

  .field__blurb {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* The open call is the one thing on this page a visitor can act on today,
     so it gets the language's loudest element: the two-pixel box. */
  .current__link {
    display: block;
    border: var(--rule-thick) solid var(--color-text);
    padding: var(--space-s);
    transition: background-color 100ms linear;
  }

  .current__link:hover {
    background-color: var(--color-surface);
  }

  .current__title {
    display: block;
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-xs);
  }

  .current__blurb {
    display: block;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--color-muted);
  }

  .current__until {
    display: block;
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .current__cta {
    display: inline-block;
    margin-top: var(--space-s);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: var(--rule-thick) solid var(--color-text);
    padding-bottom: 0.15em;
  }
</style>
