---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import ActivityRow from '../components/ActivityRow.astro';
import { CATEGORY_META } from '../content.config';
import { CURRENT } from '../config';
import { getPublishedActivity } from '../lib/activity';
import { RECENT_WINDOW_MONTHS, groupByMonth, recentFeed } from '../lib/recent';
import {
  byCategory,
  categoryCounts,
  categoryPath,
  getPublishedWorks,
  getVisibleWorks,
  selectFeatured,
} from '../lib/works';

// The open call disappears after its last day: at build time here, and in the
// visitor's browser too (below), since nothing rebuilds the site on that date.
const currentOpen = CURRENT ? Date.now() <= Date.parse(`${CURRENT.endsOn}T23:59:59Z`) : false;
const published = await getPublishedWorks();
const visible = await getVisibleWorks();

// Everything from the last three months in one chronological run — works and
// activity together, newest first. `date` is the sort key that decides this, so
// keep it truthful and never post-date a work to push it up the page.
const { items: recent, windowed } = recentFeed(published, await getPublishedActivity());

const recentIds = new Set(
  recent.filter((item) => item.kind === 'work').map((item) => item.work.id),
);

// The marker beside the heading says what the block is actually showing: the
// window when the window is in force, the year of the newest row when it is not.
const recentMarker = windowed
  ? `Last ${RECENT_WINDOW_MONTHS} months`
  : String(recent[0]?.date.getUTCFullYear() ?? '');

const recentMonths = groupByMonth(recent);

// Featured works that the Recent block has not already shown.
const featured = selectFeatured(published, 8).filter((w) => !recentIds.has(w.id));

const counts = categoryCounts(published);
const foreground = counts.filter(({ category }) => category !== 'acoustic');

// Acoustic sits apart as a quieter archive layer. Anything already shown above
// is left out, so no work appears twice on the same page.
const shownAbove = new Set([...recentIds, ...featured.map((w) => w.id)]);
const acoustic = byCategory(visible, 'acoustic').filter((w) => !shownAbove.has(w.id));
---

{/* The name and the tagline are in the masthead on every page now, this one
    included, so the home page opens on the work rather than on a wordmark. */}
<BaseLayout isHome jsonLd={undefined}>
  {
    currentOpen && CURRENT && (
      <section class="section--tight shell current" aria-labelledby="current-heading" data-ends-on={CURRENT.endsOn}>
        <a class="current__link" href={CURRENT.href}>
          <span class="current__main">
            <span class="eyebrow">{CURRENT.eyebrow}</span>
            <span id="current-heading" class="current__title title-l">
              {CURRENT.title}
            </span>
            <span class="current__blurb">{CURRENT.blurb}</span>
          </span>
          <span class="current__aside">
            <span class="current__until">{CURRENT.until}</span>
            <span class="current__cta">{CURRENT.cta} →</span>
          </span>
        </a>
      </section>
    )
  }

  <section class="section--tight shell" aria-labelledby="recent-heading">
    <div class="head">
      <h2 id="recent-heading" class="eyebrow">Recent</h2>
      <p class="head__count index">{recentMarker}</p>
    </div>
    <div class="list">
      {
        /* The running index is the position in the whole feed, not in the
           month, so the numbers read straight down the page. */
        recentMonths.map((month, groupIndex) => {
          const offset = recentMonths
            .slice(0, groupIndex)
            .reduce((n, m) => n + m.items.length, 0);

          return (
            <div class="month">
              <h3 class="month__label eyebrow">{month.label}</h3>
              {month.items.map((item, i) =>
                item.kind === 'activity' ? (
                  <ActivityRow entry={item.entry} index={offset + i} />
                ) : (
                  <WorkRow work={item.work} index={offset + i} />
                ),
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section--tight shell" aria-labelledby="featured-heading">
        <div class="head">
          <h2 id="featured-heading" class="eyebrow">
            Featured works
          </h2>
          <a class="link" href="/works">
            All works →
          </a>
        </div>
        <div class="list">
          {featured.map((work, i) => (
            <WorkRow work={work} index={recent.length + i} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section--tight shell" aria-labelledby="fields-heading">
    <div class="head">
      <h2 id="fields-heading" class="eyebrow">Fields of work</h2>
    </div>
    <ul class="fields">
      {
        foreground.map(({ category, count }) => (
          <li class:list={['field', `field--${category}`]}>
            <a class="field__link" href={categoryPath(category)}>
              <span class="field__head">
                <span class:list={['mark', `mark--${category}`]} aria-hidden="true" />
                <span class="field__count index">
                  {String(count).padStart(2, '0')} {count === 1 ? 'work' : 'works'}
                </span>
              </span>
              <span class="field__label title-m">{CATEGORY_META[category].label}</span>
              <span class="field__blurb">{CATEGORY_META[category].blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section--tight shell" aria-labelledby="acoustic-heading">
    <div class="head">
      <h2 id="acoustic-heading" class="eyebrow">Acoustic — archive</h2>
      <a class="link" href={categoryPath('acoustic')}>Open archive →</a>
    </div>
    <p class="head__note meta meta--tight">{CATEGORY_META.acoustic.blurb}</p>
    <div class="list list--quiet">
      {acoustic.map((work, i) => <WorkRow work={work} index={i} variant="compact" />)}
    </div>
  </section>
  <script is:inline>
    (() => {
      const block = document.querySelector('[data-ends-on]');
      if (block && Date.now() > Date.parse(block.getAttribute('data-ends-on') + 'T23:59:59Z')) block.remove();
    })();
  </script>
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
    padding-bottom: var(--space-xs);
  }

  .head__note {
    max-width: 62ch;
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-s);
  }

  .list {
    border-bottom: var(--rule-thin) solid var(--color-line);
  }

  /* The month is a spine for the feed, not a heading in its own right: a
     hairline, the month, and the rows beneath it. */
  .month__label {
    padding-top: var(--space-m);
    padding-bottom: var(--space-2xs);
    color: var(--color-muted);
  }

  .month:first-child .month__label {
    padding-top: var(--space-xs);
  }

  .fields {
    margin-top: var(--space-2xs);
    border-bottom: var(--rule-thin) solid var(--color-line);
  }

  /* Three fields, three rules, side by side once there is room. */
  @media (min-width: 48rem) {
    .fields {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      border-bottom: 0;
    }
  }

  .field {
    border-top: var(--rule-thin) solid var(--color-line);
  }

  .field--ai {
    border-top-width: var(--rule-thick);
    border-top-color: var(--color-text);
  }
  .field--electroacoustic {
    border-top-color: var(--color-text);
  }

  .field__link {
    display: block;
    height: 100%;
    padding-block: var(--space-s);
    transition: background-color 100ms linear;
  }

  .field__link:hover {
    background-color: var(--color-surface);
  }

  .field__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-2xs);
  }

  .field__count {
    text-transform: uppercase;
  }

  .field__label {
    display: block;
  }

  .field__blurb {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* The open call is the one thing on this page a visitor can act on today,
     so it gets the language's loudest element: the two-pixel box. */
  .current__link {
    display: grid;
    gap: var(--space-m) var(--grid-gap);
    border: var(--rule-thick) solid var(--color-text);
    padding: var(--space-m);
    transition: background-color 100ms linear;
  }

  /* The call takes the whole width, so it is set as two fields: what it is
     on the left, when it closes and how to act on the right. */
  @media (min-width: 56rem) {
    .current__link {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
    }

    .current__aside {
      justify-self: end;
      text-align: right;
    }
  }

  .current__link:hover {
    background-color: var(--color-surface);
  }

  .current__title {
    display: block;
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-xs);
  }

  .current__blurb {
    display: block;
    max-width: 68ch;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--color-muted);
  }

  .current__aside {
    display: block;
  }

  .current__until {
    display: block;
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .current__cta {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: var(--rule-thick) solid var(--color-text);
    padding-bottom: 0.15em;
  }
</style>
