---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import ActivityRow from '../components/ActivityRow.astro';
import { CATEGORY_META } from '../content.config';
import { CURRENT, SITE } from '../config';
import { href } from '../lib/paths';
import { getPublishedActivity } from '../lib/activity';
import { RECENT_WINDOW_MONTHS, groupByMonth, recentFeed } from '../lib/recent';
import {
  byCategory,
  categoryCounts,
  categoryPath,
  getPublishedWorks,
  getVisibleWorks,
  selectFeatured,
} from '../lib/works';

// The open call disappears after its last day: at build time here, and in the
// visitor's browser too (below), since nothing rebuilds the site on that date.
const currentOpen = CURRENT ? Date.now() <= Date.parse(`${CURRENT.endsOn}T23:59:59Z`) : false;
const published = await getPublishedWorks();
const visible = await getVisibleWorks();

// Everything from the last three months in one chronological run — works and
// activity together, newest first. `date` is the sort key that decides this, so
// keep it truthful and never post-date a work to push it up the page.
const { items: recent, windowed } = recentFeed(published, await getPublishedActivity());

const recentIds = new Set(
  recent.filter((item) => item.kind === 'work').map((item) => item.work.id),
);

// The marker beside the heading says what the block is actually showing: the
// window when the window is in force, the year of the newest row when it is not.
const recentMarker = windowed
  ? `Last ${RECENT_WINDOW_MONTHS} months`
  : String(recent[0]?.date.getUTCFullYear() ?? '');

const recentMonths = groupByMonth(recent);

// Featured works that the Recent block has not already shown.
const featured = selectFeatured(published, 8).filter((w) => !recentIds.has(w.id));

const counts = categoryCounts(published);
const foreground = counts.filter(({ category }) => category !== 'acoustic');

// Acoustic sits apart as a quieter archive layer. Anything already shown above
// is left out, so no work appears twice on the same page.
const shownAbove = new Set([...recentIds, ...featured.map((w) => w.id)]);
const acoustic = byCategory(visible, 'acoustic').filter((w) => !shownAbove.has(w.id));

// The tagline is two sentences: who he is, and the idea.
const [who, ...restOfTagline] = SITE.tagline.split('. ');
const idea = restOfTagline.join('. ');
---

<BaseLayout isHome jsonLd={undefined}>
  <section class="shell sec intro" aria-label="Introduction">
    <p class="sec__label">{who}</p>
    <div class="sec__body">
      {idea && <p class="title-l intro__idea">{idea}</p>}
      <p class="intro__ways">
        <a class="link" href={href('/works')}>Works →</a>
        <a class="link" href={href('/about')}>About →</a>
      </p>
    </div>
  </section>

  {
    currentOpen && CURRENT && (
      <section class="shell sec current" aria-labelledby="current-heading" data-ends-on={CURRENT.endsOn}>
        <p class="sec__label">{CURRENT.eyebrow}</p>
        <div class="sec__body">
          <a class="current__link" href={href(CURRENT.href)}>
            <span id="current-heading" class="title-l current__title">
              {CURRENT.title}
            </span>
            <span class="current__blurb">{CURRENT.blurb}</span>
            <span class="current__until">{CURRENT.until}</span>
            <span class="current__cta">{CURRENT.cta} →</span>
          </a>
        </div>
      </section>
    )
  }

  <section class="shell sec" aria-labelledby="recent-heading">
    <div class="sec__label">
      <h2 id="recent-heading">Recent</h2>
      <p class="index">{recentMarker}</p>
    </div>
    <div class="sec__body feed">
      {
        recentMonths.map((month, groupIndex) => {
          const offset = recentMonths
            .slice(0, groupIndex)
            .reduce((n, m) => n + m.items.length, 0);

          return (
            <div class="month">
              <h3 class="month__label">{month.label}</h3>
              <div class="entries">
                {month.items.map((item, i) =>
                  item.kind === 'activity' ? (
                    <ActivityRow entry={item.entry} index={offset + i} />
                  ) : (
                    <WorkRow work={item.work} index={offset + i} />
                  ),
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="shell sec" aria-labelledby="featured-heading">
        <div class="sec__label">
          <h2 id="featured-heading">Featured works</h2>
          <a class="link" href={href('/works')}>
            All works →
          </a>
        </div>
        <div class="sec__body entries">
          {featured.map((work, i) => (
            <WorkRow work={work} index={recent.length + i} />
          ))}
        </div>
      </section>
    )
  }

  <section class="shell sec" aria-labelledby="fields-heading">
    <h2 id="fields-heading" class="sec__label">Fields of work</h2>
    <ul class="sec__body fields">
      {
        foreground.map(({ category, count }) => (
          <li class:list={['field', `field--${category}`]}>
            <a class="field__link" href={categoryPath(category)}>
              <span class="field__label title-m">{CATEGORY_META[category].label}</span>
              <span class="field__count index">
                {String(count).padStart(2, '0')} {count === 1 ? 'work' : 'works'}
              </span>
              <span class="field__blurb">{CATEGORY_META[category].blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell sec" aria-labelledby="acoustic-heading">
    <div class="sec__label">
      <h2 id="acoustic-heading">Acoustic — archive</h2>
      <a class="link" href={categoryPath('acoustic')}>Open archive →</a>
    </div>
    <div class="sec__body">
      <p class="archive__note">{CATEGORY_META.acoustic.blurb}</p>
      <div class="entries entries--small">
        {acoustic.map((work, i) => <WorkRow work={work} index={i} variant="compact" />)}
      </div>
    </div>
  </section>
  <script is:inline>
    (() => {
      const block = document.querySelector('[data-ends-on]');
      if (block && Date.now() > Date.parse(block.getAttribute('data-ends-on') + 'T23:59:59Z')) block.remove();
    })();
  </script>
</BaseLayout>

<style>
  .intro {
    margin-top: clamp(5rem, 14vw, 11rem);
  }

  .intro__idea {
    max-width: 24ch;
  }

  .intro__ways {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .current__link {
    display: grid;
    gap: 0.6rem;
    max-width: 62ch;
  }

  .current__title {
    display: block;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
    transition: text-decoration-color 140ms ease;
  }

  .current__link:hover .current__title {
    text-decoration-color: currentColor;
  }

  .current__blurb {
    display: block;
  }

  .current__until {
    display: block;
    color: var(--grey);
  }

  .current__cta {
    display: block;
    font-weight: 500;
  }

  .sec__label :global(.link) {
    display: inline-block;
    margin-top: 0.3rem;
  }

  .feed {
    display: grid;
    gap: 3.5rem;
  }

  .month + .month {
    position: relative;
  }

  .month + .month::before {
    content: '';
    position: absolute;
    top: -1.75rem;
    left: 0;
    width: 1.1rem;
    height: 1px;
    background: var(--line);
  }

  .month__label {
    margin-bottom: 1.25rem;
    color: var(--grey);
  }

  .fields {
    display: grid;
    gap: 2rem;
  }

  .field__link {
    display: grid;
    gap: 0.15rem;
    max-width: 62ch;
  }

  .field__label {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 140ms ease;
  }

  .field__link:hover .field__label {
    text-decoration-color: currentColor;
  }

  .field__count {
    color: var(--grey);
  }

  .field__blurb {
    margin-top: 0.3rem;
  }

  .archive__note {
    max-width: 62ch;
    margin-bottom: 1.5rem;
    color: var(--grey);
  }
</style>
