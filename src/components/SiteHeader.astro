---
import { AGORA, NAV, SITE } from '../config';
import { href, routeOf } from '../lib/paths';
import AgoraBadge from './AgoraBadge.astro';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const path = routeOf(Astro.url.pathname);
const isActive = (target: string) => path === target || path.startsWith(`${target}/`);
---

{
  /* The name on the left; the five rooms of the site listed beside it; the
     Agora and the way to commission a work at the far side. */
}
<header class="shell head">
  <div class="head__id">
    {
      isHome ? (
        <h1 class="head__name">
          <a href={href('/')}>{SITE.name}</a>
        </h1>
      ) : (
        <a class="head__name" href={href('/')}>
          {SITE.name}
        </a>
      )
    }
    <p class="head__role">{SITE.role}</p>
  </div>

  <nav class="head__nav" aria-label="Primary">
    {
      NAV.map((item) => (
        <a class="head__item" href={href(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="head__agora">
    <AgoraBadge />
    <a class="link" href={AGORA.commissionUrl} rel="noopener noreferrer" target="_blank">
      Commission a new work →
    </a>
  </div>
</header>

<style>
  .head {
    display: grid;
    gap: 1.25rem var(--col-gap);
    padding-top: 1.75rem;
  }

  @media (min-width: 52rem) {
    .head {
      grid-template-columns: var(--label) minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  .head__name {
    font-weight: 500;
  }

  .head__role {
    color: var(--grey);
  }

  /* The rooms: one under another on a desk, in a line on a phone. */
  .head__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.25rem;
  }

  @media (min-width: 52rem) {
    .head__nav {
      flex-direction: column;
    }
  }

  .head__item {
    justify-self: start;
    width: max-content;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 140ms ease;
  }

  .head__item:hover {
    text-decoration-color: var(--hair);
  }

  .head__item[aria-current='page'] {
    text-decoration-color: currentColor;
  }

  /* The Agora and the way to commission a work, together in a box. */
  .head__agora {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    justify-self: start;
    padding: 0.75rem 0.95rem 0.8rem;
    border: 1px solid var(--panel-line);
    background: var(--panel);
  }

  @media (min-width: 52rem) {
    .head__agora {
      justify-self: end;
    }
  }
</style>
