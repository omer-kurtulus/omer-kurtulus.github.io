---
import { NAV, SITE } from '../config';
import AgoraBadge from './AgoraBadge.astro';
import { mailtoHref } from '../lib/contact';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site">
  <div class="shell">
    <div class="site__top">
    {
      /* The name is the page's h1 on the home page and a link everywhere else,
         so every page carries the same masthead without claiming two h1s. */
      isHome ? (
        <h1 class="site__h1">
          <a class="brand" href="/">
            {SITE.name}
          </a>
        </h1>
      ) : (
        <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
          {SITE.name}
        </a>
      )
    }

    <p class="tagline">{SITE.tagline}</p>

    <div class="site__agora">
      <AgoraBadge />
      {
        SITE.email && (
          <a class="commission" href={mailtoHref({ to: SITE.email, subject: 'Commission enquiry' })}>
            Commission a new work →
          </a>
        )
      }
    </div>
    </div>

    <nav class="tabs" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* Two-pixel black bar under the masthead, the way the open call sets it.
     Not sticky: the page is one column and the nav is four lines from the top
     of every screen anyway. */
  .site {
    padding-top: var(--space-m);
    margin-bottom: var(--space-m);
    border-bottom: var(--rule-thick) solid var(--color-text);
  }

  /* The Agora badge has its own column, right of the tagline, behind a
     hairline — it never shares space with the text. On narrow screens it
     moves above the name, aligned right. */
  .site__agora {
    order: -1;
    grid-column: 1 / -1;
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }

  /* The way to commission a work — under the badge, and separate from it:
     the badge goes to the Agora, this line writes to Ömer. */
  .commission {
    padding-top: var(--space-2xs);
    border-top: var(--rule-thin) solid var(--color-line);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
    transition: color 100ms linear;
  }

  .commission:hover {
    color: #d0021b;
  }

  @media (min-width: 64rem) {
    .site__agora {
      order: 0;
      grid-column: auto;
      align-self: stretch;
      justify-content: flex-start;
      padding-left: var(--space-m);
      border-left: var(--rule-thin) solid var(--color-line);
    }
  }

  /* Name and tagline sit across the page, the tabs on the rule under them. */
  .site__top {
    display: grid;
    gap: var(--space-2xs) var(--grid-gap);
    align-items: end;
    margin-bottom: var(--space-s);
  }

  @media (min-width: 56rem) {
    .site__top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  /* Wide enough for three columns: the badge takes its own, right of the tagline. */
  @media (min-width: 64rem) {
    .site__top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr) auto;
      column-gap: var(--space-l);
    }
  }

  .site__h1 {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  .brand {
    display: block;
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: var(--space-2xs);
  }

  .tagline {
    margin: 0;
    max-width: 48ch;
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @media (min-width: 56rem) {
    .tagline {
      padding-bottom: 0.5em;
    }
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
  }

  .tabs a {
    display: block;
    padding: 0.55rem 0;
    color: var(--color-muted);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 3px solid transparent;
    /* Sits the active underline on the masthead bar rather than above it. */
    margin-bottom: calc(var(--rule-thick) * -1);
    transition: color 100ms linear;
  }

  .tabs a:hover {
    color: var(--color-text);
  }

  .tabs a[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }
</style>
