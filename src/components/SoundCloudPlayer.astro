---
import { soundcloudEmbedSrc } from '../lib/works';

interface Props {
  url: string;
  title?: string;
  note?: string;
  workTitle: string;
}

const { url, title, note, workTitle } = Astro.props;
const label = title ? `${workTitle} — ${title}` : workTitle;
---

<div class="player">
  <button class="player__trigger" type="button" data-embed={soundcloudEmbedSrc(url)}>
    <span class="player__meta">
      <span class="eyebrow">Listen</span>
      {title && <span class="player__variant meta meta--tight">{title}</span>}
    </span>

    <span class="player__cue">
      <!-- Geometric play cue: a triangle drawn from borders. No waveform, no icon set. -->
      <span class="player__triangle" aria-hidden="true"></span>
      <span class="player__action">Play on SoundCloud</span>
    </span>

    <span class="visually-hidden">Load the SoundCloud player for {label}</span>
  </button>

  {note && <p class="player__note meta meta--tight">{note}</p>}

  <noscript>
    <p class="player__note meta meta--tight">
      <a class="link" href={url} rel="noopener noreferrer" target="_blank">
        Listen on SoundCloud
      </a>
    </p>
  </noscript>
</div>

<style>
  .player {
    display: grid;
    gap: 0.5rem;
  }

  /* A single line: a small triangle, what it is, and where it plays. */
  .player__trigger {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
    width: 100%;
    padding: 0.85rem 0;
    border: 0;
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .player__meta {
    order: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6rem;
  }

  .player__meta .eyebrow {
    font-weight: 500;
  }

  .player__variant {
    color: var(--grey);
  }

  .player__cue {
    display: contents;
  }

  .player__triangle {
    order: 1;
    flex: none;
    align-self: center;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.36rem 0 0.36rem 0.6rem;
    border-color: transparent transparent transparent var(--ink);
  }

  .player__action {
    order: 3;
    margin-left: auto;
    color: var(--grey);
    font-size: var(--fs-s);
  }

  .player__trigger:hover .player__meta .eyebrow {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .player :global(iframe) {
    display: block;
    width: 100%;
    height: 166px;
    border: 0;
  }

  .player__note {
    max-width: 62ch;
    color: var(--grey);
    font-size: var(--fs-s);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.player__trigger').forEach((trigger) => {
    trigger.addEventListener(
      'click',
      () => {
        const src = trigger.dataset.embed;
        if (!src) return;

        // Stop the site-wide player before a second stream starts.
        document.dispatchEvent(new CustomEvent('ambient:yield'));

        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = 'SoundCloud player';
        iframe.allow = 'autoplay';
        iframe.loading = 'lazy';
        iframe.setAttribute('scrolling', 'no');
        iframe.setAttribute('frameborder', 'no');

        trigger.replaceWith(iframe);
      },
      { once: true },
    );
  });
</script>
