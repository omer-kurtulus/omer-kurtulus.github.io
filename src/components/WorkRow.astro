---
/**
 * A work, as an entry in a gallery's list: the title, a quiet line saying
 * what and when, and — in the full form — what it is.
 */
import { getEntry } from 'astro:content';
import { CATEGORY_META } from '../content.config';
import { partLabel, workPath, type Work } from '../lib/works';

interface Props {
  work: Work;
  /** Kept for the callers; the gallery does not number its works. */
  index?: number;
  /** Set on album pages, where repeating the album name on every entry is noise. */
  hideSeries?: boolean;
  /**
   * large / default — title, description and facts
   * compact         — the quiet archive layer: title, field and year
   */
  variant?: 'large' | 'default' | 'compact';
}

const { work, variant = 'default', hideSeries = false } = Astro.props;
const { data } = work;
const category = CATEGORY_META[data.primaryCategory];
const part = partLabel(work);
const showSeries = !hideSeries && Boolean(data.series);
const seriesEntry = data.series ? await getEntry(data.series.id) : undefined;
const full = variant !== 'compact';

const facts = [
  data.instrumentation,
  data.duration,
  data.technology.slice(0, 3).join(' · ') || undefined,
].filter(Boolean) as string[];
---

<article class:list={['entry', `entry--${variant}`]}>
  <a class="entry__link" href={workPath(work)}>
    <span class:list={['entry__title', full ? 'title-m' : 'title-s']}>{data.title}</span>
    <span class="entry__line">
      <span>{category.short}</span>
      {
        showSeries && seriesEntry && (
          <span>
            {seriesEntry.data.title}
            {part && ` ${part}`}
          </span>
        )
      }
      <span class="index">{data.year}</span>
    </span>
    {full && data.shortDescription && <span class="entry__description">{data.shortDescription}</span>}
    {
      full && facts.length > 0 && (
        <span class="entry__facts small">
          {facts.map((fact) => (
            <span>{fact}</span>
          ))}
        </span>
      )
    }
  </a>
</article>

<style>
  .entry__link {
    display: grid;
    gap: 0.2rem;
    max-width: 62ch;
  }

  .entry__title {
    display: block;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 140ms ease;
  }

  .entry__link:hover .entry__title {
    text-decoration-color: currentColor;
  }

  .entry__line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.45rem;
    color: var(--grey);
  }

  .entry__line > * + *::before {
    content: '·';
    margin-right: 0.45rem;
  }

  .entry__description {
    display: block;
    margin-top: 0.35rem;
  }

  .entry__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.45rem;
    margin-top: 0.2rem;
    color: var(--grey);
  }

  .entry__facts > * + *::before {
    content: '/';
    margin-right: 0.45rem;
  }

  /* The quiet archive layer: title and line side by side. */
  .entry--compact .entry__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.9rem;
  }
</style>
