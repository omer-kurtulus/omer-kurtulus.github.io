---
import { AGORA, FOLLOW, NAV, PROFILES, SITE } from '../config';
import { href } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="shell foot">
  <p class="foot__legal">{`© ${year} ${SITE.name}`}</p>

  <div class="foot__body">
    <div class="foot__id">
      <p>{`${SITE.name} — ${SITE.role}`}</p>
      <p class="foot__tagline">{SITE.tagline}</p>
      <p class="foot__agora">
        {AGORA.role}, <a class="link" href={AGORA.url} rel="noopener noreferrer" target="_blank">{AGORA.name}</a>
      </p>
      {SITE.email && <p><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>}
    </div>

    <nav class="foot__col" aria-label="Footer">
      {NAV.map((item) => <a class="link" href={href(item.href)}>{item.label}</a>)}
    </nav>

    <div class="foot__col">
      {
        PROFILES.map((profile) => (
          <a class="link" href={profile.url} rel="me noopener noreferrer" target="_blank">
            {profile.label}
          </a>
        ))
      }
      <a class="link" href={FOLLOW.url} rel="noopener noreferrer" target="_blank">{FOLLOW.label}</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    display: grid;
    gap: 1.25rem var(--col-gap);
    margin-top: var(--sec);
    padding-bottom: 4rem;
    color: var(--grey);
    font-size: var(--fs-s);
  }

  .foot::before {
    content: '';
    position: absolute;
    top: calc(var(--sec) * -0.5);
    left: var(--pad);
    width: 2.75rem;
    height: 2px;
    background: var(--red);
  }

  @media (min-width: 52rem) {
    .foot {
      grid-template-columns: var(--label) minmax(0, 1fr);
    }
  }

  .foot__body {
    display: grid;
    gap: 1.5rem var(--col-gap);
  }

  @media (min-width: 44rem) {
    .foot__body {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .foot__id {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .foot__tagline {
    max-width: 44ch;
  }

  .foot__col {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    justify-items: start;
  }

  .foot a:hover {
    color: var(--ink);
  }

  .foot__id :global(.link),
  .foot__col :global(.link) {
    overflow-wrap: anywhere;
  }
</style>
