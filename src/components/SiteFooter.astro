---
import { NAV, PROFILES, SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="colophon">
  <div class="shell">
    <hr class="rule rule--thick" />

    <div class="colophon__grid grid">
      <!-- The one decorative element on the site: three primitives on the baseline. -->
      <div class="colophon__marks" aria-hidden="true">
        <span class="glyph glyph--square"></span>
        <span class="glyph glyph--circle"></span>
        <span class="glyph glyph--bar"></span>
      </div>

      <div class="colophon__name">
        <p class="title-m">{SITE.name}</p>
        <p class="meta meta--tight">{SITE.role}</p>
      </div>

      <nav class="colophon__nav" aria-label="Footer">
        <ul class="colophon__list">
          {
            NAV.map((item) => (
              <li>
                <a class="colophon__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="colophon__profiles">
        <ul class="colophon__list">
          {
            PROFILES.map((profile) => (
              <li>
                <a
                  class="colophon__link"
                  href={profile.url}
                  rel="me noopener noreferrer"
                  target="_blank"
                >
                  {profile.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="colophon__legal meta">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .colophon {
    padding-bottom: var(--space-m);
    margin-top: var(--space-2xl);
  }

  .colophon__grid {
    row-gap: var(--space-m);
    padding-top: var(--space-m);
  }

  .colophon__marks {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-end;
    gap: var(--space-2xs);
    height: var(--space-m);
  }

  .glyph {
    display: block;
    background: var(--color-text);
  }
  .glyph--square {
    width: var(--space-s);
    height: var(--space-s);
  }
  .glyph--circle {
    width: var(--space-s);
    height: var(--space-s);
    border-radius: 50%;
    background: var(--color-accent);
  }
  .glyph--bar {
    width: var(--space-l);
    height: var(--rule-thick);
  }

  .colophon__name {
    grid-column: 1 / -1;
  }
  .colophon__nav {
    grid-column: 1 / -1;
  }
  .colophon__profiles {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .colophon__marks {
      grid-column: 1 / 3;
    }
    .colophon__name {
      grid-column: 3 / 8;
    }
    .colophon__nav {
      grid-column: 8 / 11;
    }
    .colophon__profiles {
      grid-column: 11 / -1;
    }
  }

  .colophon__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
  }

  @media (min-width: 48rem) {
    .colophon__list {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }

  .colophon__link {
    font-size: var(--step--2);
    font-stretch: 78%;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 120ms linear;
  }

  .colophon__link:hover {
    color: var(--color-accent);
  }

  .colophon__legal {
    margin-top: var(--space-l);
    font-size: var(--step--2);
  }
</style>
