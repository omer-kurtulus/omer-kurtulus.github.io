---
import { NAV, PROFILES, SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="site">
  <div class="shell">
    <div class="colophon">
    <p class="colophon__name">{SITE.name} — {SITE.role}</p>

    <nav class="colophon__row" aria-label="Footer">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="colophon__row">
      {
        PROFILES.map((profile) => (
          <a href={profile.url} rel="me noopener noreferrer" target="_blank">
            {profile.label}
          </a>
        ))
      }
    </div>

    <p class="colophon__legal">© {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  /* The closing bar answers the masthead: same two pixels, same black. */
  .site {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-l);
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--color-muted);
  }

  .colophon {
    border-top: var(--rule-thick) solid var(--color-text);
    padding-top: var(--space-s);
  }

  .colophon__name {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-xs);
  }

  .colophon__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem var(--space-s);
    margin-bottom: var(--space-2xs);
  }

  .colophon__row a {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 100ms linear;
  }

  .colophon__row a:hover {
    color: var(--color-text);
  }

  .colophon__legal {
    margin-top: var(--space-m);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
