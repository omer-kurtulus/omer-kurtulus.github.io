---
import { AGORA, FOLLOW, NAV, PROFILES, SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="site">
  <div class="shell">
    <div class="colophon">
    <div class="colophon__id">
      <p class="colophon__name">{SITE.name} — {SITE.role}</p>
      <p class="colophon__agora">
        {AGORA.role}, <a href={AGORA.url} rel="noopener noreferrer" target="_blank">{AGORA.name}</a>
      </p>
      {SITE.email && <p class="colophon__email"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>}
    </div>

    <nav class="colophon__row" aria-label="Footer">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="colophon__row">
      {
        PROFILES.map((profile) => (
          <a href={profile.url} rel="me noopener noreferrer" target="_blank">
            {profile.label}
          </a>
        ))
      }
      <a href={FOLLOW.url} rel="noopener noreferrer" target="_blank">{FOLLOW.label}</a>
    </div>

    <p class="colophon__legal">© {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  /* The closing bar answers the masthead: same two pixels, same black. */
  .site {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-l);
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--color-muted);
  }

  .colophon {
    border-top: var(--rule-thick) solid var(--color-text);
    padding-top: var(--space-s);
  }

  @media (min-width: 56rem) {
    .colophon {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr);
      column-gap: var(--grid-gap);
    }

    .colophon__row {
      flex-direction: column;
      gap: var(--space-2xs);
    }

    .colophon__legal {
      grid-column: 1 / -1;
      margin-top: var(--space-l);
    }
  }

  .colophon__name {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-xs);
  }

  .colophon__agora,
  .colophon__email {
    margin-bottom: var(--space-2xs);
  }

  .colophon__agora a,
  .colophon__email a {
    color: var(--color-text);
    border-bottom: var(--rule-thin) solid var(--color-line);
    transition: border-color 100ms linear;
  }

  .colophon__agora a:hover,
  .colophon__email a:hover {
    border-bottom-color: var(--color-text);
  }

  .colophon__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem var(--space-s);
    margin-bottom: var(--space-2xs);
  }

  .colophon__row a {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 100ms linear;
  }

  .colophon__row a:hover {
    color: var(--color-text);
  }

  .colophon__legal {
    margin-top: var(--space-m);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
