---
import { soundcloudEmbedSrc } from '../lib/works';

interface Props {
  /** SoundCloud track the site plays to every visitor. */
  url: string;
  label: string;
}

const { url, label } = Astro.props;
const embedSrc = soundcloudEmbedSrc(url);
---

<!--
  The track plays for everyone; nothing about it is shown. The only visible
  trace is the browser's own tab audio indicator, which is also the visitor's
  way out — the page offers no control of its own, by design.
-->
<iframe
  class="ambient"
  data-ambient-frame
  src={embedSrc}
  title={`Audio: ${label}`}
  allow="autoplay"
  tabindex="-1"
  aria-hidden="true"></iframe>

<style>
  .ambient {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  /**
   * Starts the site's track for every visitor.
   *
   * No browser permits audible autoplay before the visitor has interacted with
   * the origin, so a bare `play()` on load succeeds only for someone the
   * browser already trusts with this domain. For everyone else the first
   * pointer or key event anywhere on the page starts it — no button, no label,
   * nothing to click deliberately. The playhead is kept in sessionStorage, so
   * moving between pages resumes rather than restarting, and a work's own
   * player pauses it instead of talking over it.
   */
  const KEY_POSITION = 'ambient:position';
  const KEY_SILENCED = 'ambient:silenced';
  const API = 'https://w.soundcloud.com/player/api.js';

  const frame = document.querySelector<HTMLIFrameElement>('[data-ambient-frame]');

  const read = (key: string) => {
    try {
      return sessionStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const write = (key: string, value: string) => {
    try {
      sessionStorage.setItem(key, value);
    } catch {
      /* private mode — playback still works, it just will not resume */
    }
  };

  if (frame) {
    const script = document.createElement('script');
    script.src = API;
    script.async = true;
    document.head.appendChild(script);

    script.addEventListener('load', () => {
      // @ts-expect-error — SC is injected by the widget API
      const widget = SC.Widget(frame);
      // @ts-expect-error
      const Events = SC.Widget.Events;

      let ready = false;

      const start = () => {
        if (!ready || read(KEY_SILENCED) === '1') return;
        widget.play();
      };

      widget.bind(Events.READY, () => {
        ready = true;

        const saved = Number(read(KEY_POSITION) ?? 0);
        if (saved > 0) widget.seekTo(saved);

        // Succeeds only where the browser already trusts this origin.
        start();
      });

      // The first real interaction anywhere on the page grants permission.
      const events = ['pointerdown', 'keydown', 'touchstart'] as const;
      const onFirstGesture = () => {
        start();
        for (const type of events) document.removeEventListener(type, onFirstGesture);
      };
      for (const type of events) {
        document.addEventListener(type, onFirstGesture, { passive: true });
      }

      widget.bind(Events.PLAY_PROGRESS, (data: { currentPosition: number }) => {
        write(KEY_POSITION, String(Math.floor(data.currentPosition)));
      });

      widget.bind(Events.FINISH, () => write(KEY_POSITION, '0'));

      // A work's own player takes over: never two streams at once, and the
      // site track stays quiet for the rest of the visit once that happens.
      document.addEventListener('ambient:yield', () => {
        write(KEY_SILENCED, '1');
        widget.pause();
      });
    });
  }
</script>
