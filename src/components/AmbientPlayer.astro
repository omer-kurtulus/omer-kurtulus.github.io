---
import { soundcloudEmbedSrc } from '../lib/works';

interface Props {
  /** SoundCloud track offered to every visitor. */
  url: string;
  label: string;
}

const { url, label } = Astro.props;
const embedSrc = soundcloudEmbedSrc(url, { autoPlay: false });
---

<!--
  The site's track, offered rather than imposed: a small visible control in
  the corner starts and stops it. Nothing plays until the visitor asks; once
  they have, it carries on across pages until they stop it.
-->
<iframe
  class="ambient"
  data-ambient-frame
  src={embedSrc}
  title={`Audio: ${label}`}
  allow="autoplay"
  tabindex="-1"
  aria-hidden="true"></iframe>

<button class="ambient-toggle" type="button" data-ambient-toggle aria-pressed="false" hidden>
  <span class="ambient-toggle__icon" aria-hidden="true" data-ambient-icon>▶</span>
  <span class="ambient-toggle__label">{label}</span>
  <span class="visually-hidden" data-ambient-state>play</span>
</button>

<style>
  .ambient {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .ambient-toggle {
    position: fixed;
    left: var(--space-s);
    bottom: var(--space-s);
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.45rem 0.8rem;
    border: var(--rule-thin) solid var(--color-text);
    background: var(--color-background);
    color: var(--color-text);
    font: inherit;
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 100ms linear, color 100ms linear;
  }

  .ambient-toggle:hover,
  .ambient-toggle[aria-pressed='true'] {
    background: var(--color-text);
    color: var(--color-background);
  }

  .ambient-toggle[hidden] {
    display: none;
  }

  /* Room under the footer so the fixed button never covers its last lines. */
  :global(.page) {
    padding-bottom: calc(var(--space-s) * 2 + 2.5rem);
  }
</style>

<script>
  /**
   * The site's track, started only by its own button.
   *
   * Once the visitor has pressed play, the choice is kept in sessionStorage:
   * the next page resumes from the same playhead (or on their first gesture
   * there, if the browser wants one). Pressing again stops it for the rest of
   * the visit. A work's own player pauses it instead of talking over it.
   */
  const KEY_POSITION = 'ambient:position';
  const KEY_PLAYING = 'ambient:playing';
  const API = 'https://w.soundcloud.com/player/api.js';

  const frame = document.querySelector<HTMLIFrameElement>('[data-ambient-frame]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-ambient-toggle]');
  const icon = document.querySelector<HTMLElement>('[data-ambient-icon]');
  const state = document.querySelector<HTMLElement>('[data-ambient-state]');

  const read = (key: string) => {
    try {
      return sessionStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const write = (key: string, value: string) => {
    try {
      sessionStorage.setItem(key, value);
    } catch {
      /* private mode — playback still works, it just will not resume */
    }
  };

  const show = (playing: boolean) => {
    if (!toggle || !icon || !state) return;
    toggle.setAttribute('aria-pressed', String(playing));
    icon.textContent = playing ? '❚❚' : '▶';
    state.textContent = playing ? 'pause' : 'play';
  };

  if (frame && toggle) {
    const script = document.createElement('script');
    script.src = API;
    script.async = true;
    document.head.appendChild(script);

    script.addEventListener('load', () => {
      // @ts-expect-error — SC is injected by the widget API
      const widget = SC.Widget(frame);
      // @ts-expect-error
      const Events = SC.Widget.Events;

      widget.bind(Events.READY, () => {
        toggle.hidden = false;

        const saved = Number(read(KEY_POSITION) ?? 0);
        if (saved > 0) widget.seekTo(saved);

        // Only a visitor who already pressed play hears it carry on.
        if (read(KEY_PLAYING) === '1') {
          widget.play();
          const events = ['pointerdown', 'keydown', 'touchstart'] as const;
          const resume = (e: Event) => {
            if (e.target instanceof Node && toggle.contains(e.target)) return;
            if (read(KEY_PLAYING) === '1') widget.play();
            for (const type of events) document.removeEventListener(type, resume);
          };
          for (const type of events) document.addEventListener(type, resume, { passive: true });
        }
      });

      toggle.addEventListener('click', () => {
        widget.isPaused((paused: boolean) => {
          if (paused) {
            write(KEY_PLAYING, '1');
            widget.play();
          } else {
            write(KEY_PLAYING, '0');
            widget.pause();
          }
        });
      });

      widget.bind(Events.PLAY, () => show(true));
      widget.bind(Events.PAUSE, () => show(false));
      widget.bind(Events.PLAY_PROGRESS, (data: { currentPosition: number }) => {
        write(KEY_POSITION, String(Math.floor(data.currentPosition)));
      });
      widget.bind(Events.FINISH, () => {
        write(KEY_POSITION, '0');
        write(KEY_PLAYING, '0');
        show(false);
      });

      // A work's own player takes over: never two streams at once.
      document.addEventListener('ambient:yield', () => {
        write(KEY_PLAYING, '0');
        widget.pause();
      });
    });
  }
</script>
