---
/**
 * Something that happened which is not a work — a talk, a conference, a
 * residency, something founded. Set like a work's entry, with what kind of
 * thing it was and who ran it in the quiet line above the title.
 */
import { ACTIVITY_KIND_META } from '../content.config';
import { activityDate, type Activity } from '../lib/activity';

interface Props {
  entry: Activity;
  /** Kept for the callers; the gallery does not number its entries. */
  index?: number;
}

const { entry } = Astro.props;
const { data } = entry;
const kind = ACTIVITY_KIND_META[data.kind];

// An entry with a public record links out; one without is plain text rather
// than a dead link. Nothing here fabricates a destination.
const primaryLink = data.links[0];
const Tag = primaryLink ? 'a' : 'div';

const facts = [data.role, data.location].filter(Boolean) as string[];
---

<article class="entry">
  <Tag class:list={['entry__link', primaryLink && 'entry__link--live']} href={primaryLink?.url}>
    <span class="entry__line">
      <span>{kind.label}</span>
      {data.organiser && <span>{data.organiser}</span>}
    </span>
    <span class="entry__title title-m">{data.title}</span>
    <span class="entry__line">
      <span class="index">{activityDate(entry)}</span>
      {facts.map((fact) => <span>{fact}</span>)}
    </span>
    {data.summary && <span class="entry__description">{data.summary}</span>}
  </Tag>
</article>

<style>
  .entry__link {
    display: grid;
    gap: 0.2rem;
    max-width: 62ch;
  }

  .entry__title {
    display: block;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 140ms ease;
    overflow-wrap: anywhere;
  }

  .entry__link--live:hover .entry__title {
    text-decoration-color: currentColor;
  }

  .entry__line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.45rem;
    color: var(--grey);
  }

  .entry__line > * + *::before {
    content: '·';
    margin-right: 0.45rem;
  }

  .entry__description {
    display: block;
    margin-top: 0.35rem;
  }
</style>
