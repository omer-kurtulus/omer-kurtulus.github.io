---
interface Props {
  title: string;
  lead?: string;
  /** Small catalogue figure shown above the title. */
  index?: string;
  eyebrow?: string;
}

const { title, lead, index, eyebrow } = Astro.props;
const label = [eyebrow, index].filter(Boolean).join(' · ');
---

<header class="page-head">
  <div class="shell page-head__inner">
    <div class="page-head__title">
      {label && <p class="eyebrow page-head__label">{label}</p>}
      <h1 class="title-l">{title}</h1>
    </div>
    {lead && <p class="page-head__lead">{lead}</p>}
  </div>
</header>

<style>
  /* No rule of its own: the masthead bar is directly above, and a second
     black line four lines below it would read as a mistake. */
  .page-head {
    padding-top: var(--space-s);
    padding-bottom: var(--space-s);
  }

  .page-head__label {
    margin-bottom: var(--space-2xs);
  }

  @media (min-width: 56rem) {
    .page-head__inner {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--grid-gap);
      align-items: end;
    }

    .page-head__lead {
      margin-top: 0;
      padding-bottom: 0.4em;
    }
  }

  .page-head__lead {
    max-width: 52ch;
    margin-top: var(--space-s);
    font-size: var(--step-1);
    line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--color-muted);
  }
</style>
