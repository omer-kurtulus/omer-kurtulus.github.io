---
interface Props {
  title: string;
  lead?: string;
  /** A count or a date, shown quietly beside the title. */
  index?: string;
  eyebrow?: string;
}

const { title, lead, index, eyebrow } = Astro.props;
const label = [eyebrow, index].filter(Boolean).join(' · ');
---

<header class="shell sec page-head">
  <div class="sec__label">
    <slot name="before" />
    {label && <p class="index">{label}</p>}
  </div>
  <div class="sec__body">
    <h1 class="title-l page-head__title">{title}</h1>
    {lead && <p class="page-head__lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-head__title {
    max-width: 26ch;
  }

  .page-head__lead {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--grey);
    font-size: var(--fs-read);
  }
</style>
